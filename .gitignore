# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/
wheels/

# ── Virtual environments (uv recreates .venv from uv.lock) ──
.venv/
venv/
env/
.env
.envrc

# ── Tool caches ───────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# ── Experiment output ─────────────────────────────────
# Raw per-run CSVs are large (~30 MB) and regenerated by experiment.py / compare.py.
# The .txt summaries next to them are kept, since the README quotes them.
experiments/**/*.csv
experiments/runs/

# Plots are embedded in README.md, so they stay tracked.

# ── Documents ─────────────────────────────────────────
# Word/Office lock files (e.g. ~$document.docx)
~$*
*.tmp

# ── Editors / IDEs ────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ── OS files ──────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
desktop.ini
